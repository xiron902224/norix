POSTGRES_DB=norix
POSTGRES_USER=norix
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# Usada por el control plane desde el host (stack legacy deploy/postgresql).
# Prefer deploy/norix + control-plane/.env for the main local stack.
DATABASE_URL=postgres://norix:change-me-local@127.0.0.1:5432/norix?sslmode=disable
