# Copied to /data/norix/source/.env by get-norix.sh (secrets filled in).
POSTGRES_DB=norix
POSTGRES_USER=norix
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_APP_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://norix_app:CHANGE_ME@postgres:5432/norix?sslmode=disable
MIGRATION_DATABASE_URL=postgres://norix:CHANGE_ME@postgres:5432/norix?sslmode=disable
NORIX_VERSION=1.0.0-beta.3
NORIX_HTTP_PORT=8000
NORIX_PUBLIC_URL=http://127.0.0.1:8000
NORIX_WEB_ORIGIN=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=*
NORIX_REGISTRY=none
NORIX_PULL_POLICY=build
LOG_LEVEL=info
# NORIX_BUILD_SECRETS_KEY=
# NORIX_ALERT_WEBHOOK_URL=
