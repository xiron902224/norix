# Control plane local environment (host process → Postgres on loopback)
DATABASE_URL=postgres://norix_app:change-me-local@127.0.0.1:5432/norix?sslmode=disable
MIGRATION_DATABASE_URL=postgres://norix:change-me-local@127.0.0.1:5432/norix?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Edge public HTTPS port used in domain links (Caddy host mapping)
NORIX_EDGE_HTTPS_PORT=8443
NORIX_CADDY_ADMIN_URL=http://127.0.0.1:2019
NORIX_EDGE_UPSTREAM_HOST=host.docker.internal
# Resolved inside compose by Caddy; keep as hostname `pebble` for local edge.
NORIX_ACME_CA=https://pebble:14000/dir

# Leave empty / "none" unless zot is up: docker compose --profile registry up -d
NORIX_REGISTRY=none

# Ops / S7
NORIX_BACKUP_DIR=/var/tmp/norix-backups
# NORIX_ALERT_WEBHOOK_URL=https://example.com/hooks/norix
# NORIX_BUILD_SECRETS_KEY=
