# Control plane local environment (host process → Postgres on loopback)
DATABASE_URL=postgres://norix_app:change-me-local@127.0.0.1:5432/norix?sslmode=disable
MIGRATION_DATABASE_URL=postgres://norix:change-me-local@127.0.0.1:5432/norix?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Edge public HTTPS port used in domain links (Caddy host mapping)
NORIX_EDGE_HTTPS_PORT=8443
NORIX_CADDY_ADMIN_URL=http://127.0.0.1:2019
NORIX_EDGE_UPSTREAM_HOST=host.docker.internal
# Resolved inside compose by Caddy; keep as hostname `pebble` for local edge.
NORIX_ACME_CA=https://pebble:14000/dir

# Leave empty / "none" unless zot is up: docker compose --profile registry up -d
NORIX_REGISTRY=none

# Scale hard caps (#45). Defaults: nodes 32, projects 100, workloads/project 100, replicas 32, autoscaler 8.
# NORIX_MAX_NODES_PER_ORG=32
# NORIX_MAX_PROJECTS_PER_ORG=100
# NORIX_MAX_WORKLOADS_PER_PROJECT=100
# NORIX_MAX_REPLICAS=32
# NORIX_MAX_AUTOSCALER_REPLICAS=8

# Ops / S7
NORIX_BACKUP_DIR=/var/tmp/norix-backups
# NORIX_ALERT_WEBHOOK_URL=https://example.com/hooks/norix
# Email channel (#27). Webhook, Slack, and Discord need no SMTP.
# NORIX_SMTP_ADDR=smtp.example.com:587
# NORIX_SMTP_FROM=norix@example.com
# NORIX_SMTP_USER=
# NORIX_SMTP_PASSWORD=
# Required unless NORIX_ALLOW_INSECURE_DEV_SECRETS=1 (openssl rand -hex 32)
NORIX_BUILD_SECRETS_KEY=
# NORIX_ALLOW_INSECURE_DEV_SECRETS=1
# Optional: allow private Git hosts for builds (comma-separated hostnames and/or CIDRs)
# NORIX_GIT_SSRF_ALLOWLIST=git.internal.example,10.10.0.0/16
# First-admin bootstrap: allowed from loopback or HTTPS. Labs / Docker published ports:
# NORIX_ALLOW_INSECURE_BOOTSTRAP=1
# Public URL for OIDC redirect_uri ({NORIX_PUBLIC_URL}/auth/oidc/callback)
NORIX_PUBLIC_URL=http://127.0.0.1:8080
# Web UI origin after SSO callback
NORIX_WEB_ORIGIN=http://127.0.0.1:5173

