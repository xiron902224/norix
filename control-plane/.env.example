# Control plane local environment
DATABASE_URL=postgres://norix_app:change-me-local@127.0.0.1:5432/norix?sslmode=disable
MIGRATION_DATABASE_URL=postgres://norix:change-me-local@127.0.0.1:5432/norix?sslmode=disable
HTTP_ADDR=:8080

# Optional: enable a local log level when debugging
LOG_LEVEL=info

# Edge public HTTPS port used in domain links (Caddy host mapping)
NORIX_EDGE_HTTPS_PORT=8443
NORIX_CADDY_ADMIN_URL=http://127.0.0.1:2019
NORIX_EDGE_UPSTREAM_HOST=host.docker.internal

# Ops / S7
NORIX_BACKUP_DIR=/home/xiron9090/.norix/backups
# NORIX_ALERT_WEBHOOK_URL=https://example.com/hooks/norix
