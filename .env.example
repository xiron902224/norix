# Root Docker Compose environment
POSTGRES_DB=norix
POSTGRES_USER=norix
POSTGRES_PASSWORD=change-me-local
POSTGRES_APP_PASSWORD=change-me-local
DATABASE_URL=postgres://norix_app:change-me-local@postgres:5432/norix?sslmode=disable
MIGRATION_DATABASE_URL=postgres://norix:change-me-local@postgres:5432/norix?sslmode=disable
HTTP_ADDR=:8080
# Local zot registry (compose --profile registry)
NORIX_REGISTRY=127.0.0.1:5000
# Edge / TLS (S6)
NORIX_CADDY_ADMIN_URL=http://127.0.0.1:2019
NORIX_EDGE_UPSTREAM_HOST=host.docker.internal
NORIX_EDGE_HTTPS_PORT=8443
NORIX_ACME_CA=https://pebble:14000/dir
# Ops (S7)
# NORIX_BACKUP_DIR=/var/lib/norix/backups
# NORIX_ALERT_WEBHOOK_URL=https://example.com/hooks/norix
# Optional 32-byte hex key for encrypted build secrets (openssl rand -hex 32)
# NORIX_BUILD_SECRETS_KEY=
