# Root Docker Compose environment
POSTGRES_DB=norix
POSTGRES_USER=norix
POSTGRES_PASSWORD=change-me-local
POSTGRES_APP_PASSWORD=change-me-local
DATABASE_URL=postgres://norix_app:change-me-local@postgres:5432/norix?sslmode=disable
MIGRATION_DATABASE_URL=postgres://norix:change-me-local@postgres:5432/norix?sslmode=disable
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local zot registry (compose --profile registry)
NORIX_REGISTRY=127.0.0.1:5000
# Edge / TLS (S6)
NORIX_CADDY_ADMIN_URL=http://127.0.0.1:2019
NORIX_EDGE_UPSTREAM_HOST=host.docker.internal
NORIX_EDGE_HTTPS_PORT=8443
NORIX_ACME_CA=https://pebble:14000/dir
# Ops (S7)
# NORIX_BACKUP_DIR=/var/lib/norix/backups
# NORIX_ALERT_WEBHOOK_URL=https://example.com/hooks/norix
# Release history / rollback (#14)
# NORIX_RELEASE_RETENTION=10
# NORIX_AUTO_ROLLBACK=1
# Stored logs: age, line cap, and byte cap (#25). 0 disables that dimension.
# NORIX_LOG_RETENTION_DAYS=14
# NORIX_WORKLOAD_LOG_MAX_LINES=500
# NORIX_BUILD_LOG_MAX_LINES=800
# NORIX_LOG_SEGMENT_MAX_LINES=5000
# NORIX_LOG_RETENTION_BYTES=33554432
# NORIX_BUILD_LOG_RETENTION_BYTES=33554432
# NORIX_LOG_SEGMENT_RETENTION_BYTES=67108864
# Panel HTTPS (#26) — used with docker-compose.panel-tls.yml
# NORIX_PANEL_DOMAIN=norix.example.com
# NORIX_ACME_EMAIL=ops@example.com
# NORIX_ACME_CA=

# Required 32-byte hex key for encrypted build/TOTP/WireGuard secrets (openssl rand -hex 32).
# Without it the control plane refuses to start unless NORIX_ALLOW_INSECURE_DEV_SECRETS=1.
NORIX_BUILD_SECRETS_KEY=
# NORIX_ALLOW_INSECURE_DEV_SECRETS=1
# Required for POST /api/webhooks/github (PR previews)
# NORIX_GITHUB_WEBHOOK_SECRET=
# NORIX_PUBLIC_URL=http://127.0.0.1:8080
# NORIX_WEB_ORIGIN=http://127.0.0.1:5173

# Autoscaler (#49) — leader loop; per-workload NORIX_AUTOSCALE_* via UI/API
# NORIX_AUTOSCALER=1
# NORIX_AUTOSCALER_CPU_TARGET=70
# NORIX_AUTOSCALER_MEM_TARGET=0
# NORIX_AUTOSCALER_COOLDOWN_MS=30000

# WireGuard mesh (#48) — apply on by default; set 0/false/dry-run to write configs only
# NORIX_APPLY_WIREGUARD=0

# Wasm (#47) — serve on by default when wasmtime is present; set 0 to stage-only
# NORIX_WASM_SERVE=0
